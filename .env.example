# BeiFeng Wind O&M Agent environment template
# Copy to .env and fill in your own values. Never commit .env.

# Local RAG (knowledge hub) service URL
CLAW_RAG_SERVICE_URL=http://127.0.0.1:8787

# Runtime memory directory (turbine profiles, fault/maintenance history)
CLAW_RAG_MEMORY_DIR=beifeng/memory

# LLM provider endpoint (any OpenAI-compatible or DeepSeek-compatible gateway)
DEEPSEEK_BASE_URL=https://your-gateway.example.com

# LLM API key — keep it secret, never commit it
DEEPSEEK_API_KEY=your-key-here
